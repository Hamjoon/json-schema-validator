package com.networknt.schema;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.networknt.schema.SpecVersion.VersionFlag;
import org.junit.Assert;
import org.junit.Test;

import java.util.Collections;
import java.util.Set;

/**
 * JUnit‑4 test suite for {@link JsonSchema}.  The tests are written in the same
 * package as {@code JsonSchema} so that the package‑private static factory method
 * {@code JsonSchema.from(...)} can be used when a direct construction through the
 * public API is not possible.
 *
 * The suite follows the steps requested in the prompt:
 *
 * <ol>
 *   <li>List all public methods (see the comment block at the top of the file).</li>
 *   <li>Provide a basic test for each method that exercises the normal behaviour.</li>
 *   <li>Identify edge‑cases / exception paths and add dedicated tests.</li>
 *   <li>Combine everything into a single JUnit‑4 test class.</li>
 * </ol>
 *
 * The tests use the real library classes (no mocking) and keep the
 * configuration as simple as possible – a plain {@link JsonSchemaFactory}
 * with the default {@link SchemaValidatorsConfig}.
 */
public class JsonSchemaTest {

