[
  {
    "group": "NullInputString",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": null
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "When the input string is null the method should fail early (deserialize will throw) and propagate an IllegalArgumentException."
      }
    ]
  },
  {
    "group": "NullInputFormat",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"John\"}"
          },
          {
            "parameter": "inputFormat",
            "value": null
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "NullPointerException",
        "description": "A null InputFormat cannot be used for deserialization; the method is expected to throw a NullPointerException."
      }
    ]
  },
  {
    "group": "ValidJsonWithDefaultOutputFormat",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"age\":30,\"name\":\"Alice\"}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "A well\u2011formed JSON that satisfies the schema should produce an empty list of ValidationMessage when using the simple list OutputFormat."
      }
    ]
  },
  {
    "group": "MalformedJsonThrowsException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{invalidJson: true,,}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "com.fasterxml.jackson.core.JsonParseException",
        "description": "When the JSON string cannot be parsed, deserialize throws JsonParseException which should propagate out of validate."
      }
    ]
  },
  {
    "group": "CustomOutputFormatReturnsBoolean",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"valid\":true}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "BooleanOutputFormat"
          }
        ],
        "expected": "true",
        "description": "Using a custom OutputFormat that returns a Boolean should cause validate to return the value supplied by the format (true for a valid instance)."
      }
    ]
  },
  {
    "group": "EmptyJsonObject",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "An empty JSON object that conforms to the schema (no required properties) should result in an empty ValidationMessage list."
      }
    ]
  },
  {
    "group": "JsonArrayInput",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "[1,2,3]"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "When the schema permits an array, a valid JSON array should also produce an empty list of ValidationMessage."
      }
    ]
  },
  {
    "group": "NullOutputFormat",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"Bob\"}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": null
          }
        ],
        "expected": "NullPointerException",
        "description": "A null OutputFormat cannot be used; the method should throw a NullPointerException before attempting validation."
      }
    ]
  },
  {
    "group": "MissingRequiredProperty",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"age\":25}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[\"required property 'name' is missing\"]",
        "description": "The schema defines a required property 'name'. Providing JSON without this property should result in a ValidationMessage list containing the appropriate required\u2011property error."
      }
    ]
  },
  {
    "group": "ValidYamlInput",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "name: Charlie\nage: 40"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "When the InputFormat is YAML and the YAML content conforms to the schema, validate should return an empty list of ValidationMessage."
      }
    ]
  },
  {
    "group": "EmptyStringInputThrowsException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": ""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "com.fasterxml.jackson.core.JsonParseException",
        "description": "An empty string is not valid JSON; deserialization should fail with JsonParseException which propagates out of validate."
      }
    ]
  },
  {
    "group": "WhitespaceOnlyInputThrowsException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "   \n\t  "
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "com.fasterxml.jackson.core.JsonParseException",
        "description": "A string containing only whitespace cannot be parsed as JSON; JsonParseException should be thrown."
      }
    ]
  },
  {
    "group": "UnicodeJsonInput",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"Jos\u00e9\",\"city\":\"M\u00fcnchen\"}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "JSON containing Unicode characters should be deserialized correctly and, if it satisfies the schema, produce an empty ValidationMessage list."
      }
    ]
  },
  {
    "group": "LargeJsonInputValid",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"items\":[{\"id\":1,\"value\":\"a\"},{\"id\":2,\"value\":\"b\"},{\"id\":3,\"value\":\"c\"},{\"id\":4,\"value\":\"d\"},{\"id\":5,\"value\":\"e\"}],\"count\":5}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "[]",
        "description": "A relatively large but valid JSON payload should still be processed correctly and return an empty ValidationMessage list when it conforms to the schema."
      }
    ]
  },
  {
    "group": "MalformedYamlThrowsException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "name: John\nage: : thirty"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "com.fasterxml.jackson.core.JsonParseException",
        "description": "A syntactically invalid YAML document should cause the deserialization step to throw a JsonParseException which propagates out of validate."
      }
    ]
  },
  {
    "group": "InvalidUrlEncodingThrowsException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "%GG"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "SimpleListOutputFormat"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "If the input string contains malformed percent\u2011encoding, URLDecoder.decode (used inside deserialize) throws IllegalArgumentException which should be propagated by validate."
      }
    ]
  },
  {
    "group": "CustomOutputFormatThrowsRuntimeException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"valid\":true}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "ExceptionThrowingOutputFormat"
          }
        ],
        "expected": "RuntimeException",
        "description": "When a user\u2011supplied OutputFormat throws a RuntimeException during its apply/format method, validate must let the exception bubble up unchanged."
      }
    ]
  }
]