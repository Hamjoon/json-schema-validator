  {
    "group": "Invalid JsonNodePath segment \u2013 IllegalArgumentException",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "new ExecutionContext()"
          },
          {
            "parameter": "node",
            "value": "{ \"name\": \"John\" }"
          },
          {
            "parameter": "rootNode",
            "value": "{ \"name\": \"John\" }"
          },
          {
            "parameter": "instanceLocation",
            "value": "JsonNodePath.of(null)"
