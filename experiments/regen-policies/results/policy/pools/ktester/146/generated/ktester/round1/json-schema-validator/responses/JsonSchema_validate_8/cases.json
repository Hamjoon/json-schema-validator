[
  {
    "group": "Null Parameter Handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "null"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "NullPointerException",
        "description": "When the root JSON node is null the method should immediately throw a NullPointerException."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "null"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "NullPointerException",
        "description": "When the OutputFormat argument is null the method should throw a NullPointerException before any validation occurs."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "When the execution customizer (Consumer) is null the method should throw a NullPointerException."
      }
    ]
  },
  {
    "group": "Successful Validation (no errors)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "A JSON document that fully conforms to the schema should produce an empty collection of ValidationMessage objects; the CollectingFormat returns an empty list."
      }
    ]
  },
  {
    "group": "Validation Failure (error messages produced)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "invalidJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[\"type mismatch\", \"required property missing\"]",
        "description": "A JSON document that violates the schema (e.g., wrong type, missing required property) should result in a non\u2011empty set of ValidationMessage objects; the CollectingFormat returns a list containing those messages."
      }
    ]
  },
  {
    "group": "ExecutionCustomizer Interaction",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new ContextAwareFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.put(\"customFlag\", true)"
          }
        ],
        "expected": "[\"customFlag=true\"]",
        "description": "The consumer should be invoked before validation runs. The customizer stores a flag in the ExecutionContext; ContextAwareFormat reads that flag and includes it in the returned result, proving the customizer was executed."
      }
    ]
  },
  {
    "group": "Recursive Anchor Handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "simpleJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "When the schema is marked as a recursive anchor (isRecursiveAnchor() returns true) the validator must avoid infinite recursion. Supplying a trivial JSON node should complete normally and return an empty result."
      }
    ]
  },
  {
    "group": "Schema Resource Root Flag",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "If the schema reports isSchemaResourceRoot() == true, the validator may resolve external $ref resources differently. The test verifies that with a valid document the method still returns an empty result, confirming the flag does not cause an error path."
      }
    ]
  },
  {
    "group": "ExecutionCustomizer Exception Propagation",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> { throw new RuntimeException(\"customizer failure\"); }"
          }
        ],
        "expected": "RuntimeException",
        "description": "When the Consumer supplied as executionCustomizer throws an unchecked exception, the validate method must let the exception propagate unchanged."
      }
    ]
  },
  {
    "group": "OutputFormat Exception Propagation",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new OutputFormat<String>() { @Override public String format(Set<ValidationMessage> messages, ExecutionContext ctx) { throw new IllegalStateException(\"format failure\"); } }"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "IllegalStateException",
        "description": "If the OutputFormat implementation throws an exception while formatting the validation messages, the exception should bubble up to the caller."
      }
    ]
  },
  {
    "group": "Primitive Root Node Type Mismatch",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "JsonNodeFactory.instance.numberNode(42)"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[\"type mismatch\"]",
        "description": "Schema expects an object but the supplied root node is a numeric primitive; validation must report a type\u2011mismatch message."
      }
    ]
  },
  {
    "group": "Array Root Node Validation \u2013 Success",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "JsonNodeFactory.instance.arrayNode().add(1).add(2).add(3)"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "Schema defines an array of integers with minItems=3. The supplied array meets the constraints, so validation returns an empty collection."
      }
    ]
  },
  {
    "group": "Array Root Node Validation \u2013 Failure",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "JsonNodeFactory.instance.arrayNode().add(1)"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[\"minItems constraint violated\"]",
        "description": "Schema requires at least 3 items; the provided array has only one, so a minItems validation message must be produced."
      }
    ]
  },
  {
    "group": "$ref Resolution (internal definition)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNodeMatchingDefinition"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "Schema contains an internal $ref (e.g., \"#/definitions/address\"). The validator must resolve the reference and validate the instance successfully."
      }
    ]
  },
  {
    "group": "Fail\u2011Fast Mode via ExecutionContext",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "invalidJsonNodeWithMultipleErrors"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.put(ExecutionContext.KEY_FAIL_FAST, true)"
          }
        ],
        "expected": "[\"first error only\"]",
        "description": "When the execution context is configured with the fail\u2011fast flag, validation should stop after the first error, resulting in a single ValidationMessage."
      }
    ]
  },
  {
    "group": "Empty Schema (no validators)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "anyJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "An empty schema object {} defines no constraints; any JSON document must validate successfully, yielding an empty result set."
      }
    ]
  },
  {
    "group": "Recursive Anchor with Circular $ref \u2013 No StackOverflow",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "simpleJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "Schema is marked as a recursive anchor and contains a $ref that points to itself. Validation must detect the recursion guard and complete without throwing StackOverflowError."
      }
    ]
  },
  {
    "group": "Schema Resource Root with External $ref",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "[]",
        "description": "When isSchemaResourceRoot() returns true, the validator may need to resolve an external $ref (e.g., a URL). The test supplies a mock external schema that validates the instance, confirming that the flag does not break $ref handling."
      }
    ]
  },
  {
    "group": "ExecutionContext Creation Failure",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "RuntimeException",
        "description": "A subclass of JsonSchema overrides createExecutionContext() to throw a RuntimeException. The validate method should propagate this exception without catching it."
      }
    ]
  },
  {
    "group": "Malformed $ref Handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The schema contains a $ref with an illegal URI fragment (e.g., \"#/definitions/%ZZ\"). URLDecoder.decode will throw IllegalArgumentException, which must propagate out of validate()."
      }
    ]
  },
  {
    "group": "Null Validators List",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "NullPointerException",
        "description": "A JsonSchema subclass overrides getValidators() to return null. When validate() iterates over the validator list it will encounter a NullPointerException, which should be propagated."
      }
    ]
  },
  {
    "group": "OutputFormat Throws Error",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new OutputFormat<String>() { @Override public String format(Set<ValidationMessage> messages, ExecutionContext ctx) { throw new AssertionError(\"format error\"); } }"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "AssertionError",
        "description": "When the OutputFormat implementation throws an Error (AssertionError), validate() must not catch it and should let it propagate to the caller."
      }
    ]
  },
  {
    "group": "UnsupportedEncodingException from $ref Decoding",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "validJsonNode"
          },
          {
            "parameter": "format",
            "value": "new CollectingFormat<>()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> {}"
          }
        ],
        "expected": "UnsupportedEncodingException",
        "description": "A $ref contains a percent\u2011encoded sequence using an unsupported charset (e.g., \"%C3%28\"). URLDecoder.decode may throw UnsupportedEncodingException, which should be propagated by validate()."
      }
    ]
  }
]