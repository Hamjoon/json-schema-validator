        "input": [
          {
            "parameter": "executionContext",
            "value": "defaultExecutionContext()"
          },
          {
            "parameter": "input",
            "value": "{ \"name\": \"John\", \"age\": 30 }"
          },
          {
            "parameter": "inputFormat",
