        "input": [
          {
            "parameter": "executionContext",
            "value": "new ExecutionContext()"
          },
          {
            "parameter": "input",
            "value": "\"{\\\"type\\\":\\\"object\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "ValidationResult with successful validation (no errors)",
        "description": "A null customizer should be handled gracefully; the walk method should invoke walkAtNodeInternal with a no\u2011op customiser and return a normal result."
      }
    ]
  },
