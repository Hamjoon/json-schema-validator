[
  {
    "group": "Valid inputs \u2013 normal flow",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"name\\\":\\\"John\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "A well\u2011formed JSON string is supplied together with a JSON InputFormat and a simple OutputFormat that returns a string representation of the ValidationResult. No ExecutionContextCustomizer is provided, so the default execution context is used. The method should deserialize the input, run validation and return the string produced by the OutputFormat."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"age\\\":30}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "customizerMock"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "Same as the previous case but an ExecutionContextCustomizer mock is supplied. The customizer does not alter the context, therefore the validation result is identical to the case without a customizer."
      }
    ]
  },
  {
    "group": "Invalid inputs \u2013 null checks",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "null"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The input string is null. The method should validate arguments and throw IllegalArgumentException (or NullPointerException depending on implementation) before attempting deserialization."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{}\""
          },
          {
            "parameter": "inputFormat",
            "value": "null"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "InputFormat is null \u2013 the method must refuse to continue and raise an IllegalArgumentException."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "null"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "OutputFormat is null \u2013 the method should throw IllegalArgumentException because it cannot produce a result without a format."
      }
    ]
  },
  {
    "group": "Deserialization errors",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{invalidJson:}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "The supplied string is not valid JSON, causing the private `deserialize` method to throw an IOException. The exception should propagate to the caller."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"%ZZ%\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.URL_ENCODED"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "UnsupportedEncodingException",
        "description": "When the InputFormat is URL_ENCODED and the string contains malformed percent\u2011encoding, `URLDecoder.decode` throws UnsupportedEncodingException. The method must let this exception surface."
      }
    ]
  },
  {
    "group": "ExecutionContextCustomizer effects",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"type\\\":\\\"string\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "customizerAddsFlag"
          }
        ],
        "expected": "\"{\\\"valid\\\":false,\\\"message\\\":\\\"custom flag triggered\\\"}\"",
        "description": "The customizer mutates the ExecutionContext (e.g., sets a flag `skipValidation=true`). The validator checks this flag and returns a ValidationResult indicating that validation was bypassed. The OutputFormat then returns a string reflecting the bypassed validation."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"id\\\":1}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "customizerThrowsRuntimeException"
          }
        ],
        "expected": "RuntimeException",
        "description": "The customizer throws a RuntimeException while customizing the ExecutionContext. The validate method should not catch it, allowing the exception to propagate."
      }
    ]
  },
  {
    "group": "Empty and whitespace inputs",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "An empty string is supplied with JSON InputFormat. Deserialization cannot produce a JsonNode and throws an IOException, which should propagate to the caller."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"   \""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "A string containing only whitespace is supplied. The JSON parser treats it as invalid JSON and throws an IOException."
      }
    ]
  },
  {
    "group": "Valid URL\u2011ENCODED input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"%7B%22name%22%3A%22John%22%7D\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.URL_ENCODED"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "A correctly URL\u2011encoded JSON string is supplied. After decoding it becomes {\"name\":\"John\"}, which validates successfully. The StringOutputFormat returns a JSON string indicating a valid result."
      }
    ]
  },
  {
    "group": "Different InputFormat \u2013 YAML",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"name: John\\nage: 30\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "The schema supports YAML input. The supplied YAML document is syntactically correct and satisfies the schema, so validation succeeds."
      }
    ]
  },
  {
    "group": "Different OutputFormat \u2013 JsonNodeOutputFormat",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"active\\\":true}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new JsonNodeOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "JsonNode { valid:true, messages:[] }",
        "description": "Using an OutputFormat that returns a JsonNode. The method should deserialize the JSON, run validation and return a JsonNode representing a successful validation result."
      }
    ]
  },
  {
    "group": "ExecutionContextCustomizer disables type checking",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"age\\\":\\\"thirty\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "customizerDisablesTypeCheck"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "The schema expects the field 'age' to be an integer. The customizer mutates the ExecutionContext to disable type\u2011checking validators. Consequently the mismatched type does not cause a validation error and the result is reported as valid."
      }
    ]
  },
  {
    "group": "Large JSON payload",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"[\" + (\"{\\\"id\\\":1,\\\"value\\\":\\\"x\\\"},\".repeat(1000)) + \"]\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "A large JSON array containing 1000 objects is validated. The method should handle the size without throwing OutOfMemoryError or other exceptions and return a successful validation result."
      }
    ]
  },
  {
    "group": "Input with UTF\u20118 BOM handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"\\uFEFF{\\\"name\\\":\\\"BOM\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"{\\\"valid\\\":true}\"",
        "description": "The input string starts with a UTF\u20118 Byte Order Mark. The deserialization logic should ignore the BOM and correctly parse the JSON, resulting in a valid validation outcome."
      }
    ]
  },
  {
    "group": "OutputFormat throws RuntimeException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"name\\\":\\\"John\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new ThrowingOutputFormat(new RuntimeException(\"format failure\"))"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "RuntimeException",
        "description": "A valid JSON string is supplied but the provided OutputFormat throws a RuntimeException during formatting. The validate method must let the exception propagate."
      }
    ]
  },
  {
    "group": "OutputFormat throws IOException",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"id\\\":1}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new ThrowingOutputFormat(new java.io.IOException(\"IO failure\"))"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "A valid JSON string is supplied but the OutputFormat implementation throws a checked IOException. The validate method should propagate the IOException to the caller."
      }
    ]
  },
  {
    "group": "Malformed YAML input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"name: John\\n:bad\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "The supplied string is not valid YAML. Deserialization should fail and throw an IOException, which must be propagated."
      }
    ]
  },
  {
    "group": "Unsupported InputFormat handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"key\\\":\\\"value\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.XML"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "InputFormat.XML is not supported by the JsonSchema implementation. Passing it should cause the method to throw an IllegalArgumentException before any deserialization attempt."
      }
    ]
  },
  {
    "group": "ExecutionContextCustomizer returns null context",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "\"{\\\"type\\\":\\\"string\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "format",
            "value": "new StringOutputFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "customizerReturnsNull"
          }
        ],
        "expected": "NullPointerException",
        "description": "The customizer mutates the ExecutionContext and returns null. Subsequent use of the context inside validation should result in a NullPointerException, which must propagate."
      }
    ]
  }
]