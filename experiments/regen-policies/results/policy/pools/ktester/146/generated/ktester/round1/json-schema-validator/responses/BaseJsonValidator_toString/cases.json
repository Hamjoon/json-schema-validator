[
  {
    "group": "BaseJsonValidator.toString() - evaluation path handling",
    "cases": [
      {
        "input": [],
        "expected": "leaf",
        "description": "When the evaluation path contains several segments (e.g., [\"root\", \"child\", \"leaf\"]) the toString() method should return the last segment, i.e., \"leaf\"."
      },
      {
        "input": [],
        "expected": "only",
        "description": "When the evaluation path consists of a single segment (e.g., [\"only\"]) the toString() method should return that single segment."
      },
      {
        "input": [],
        "expected": "",
        "description": "When the evaluation path is empty, getName(-1) is expected to return an empty string (or null \u2013 the test asserts the actual contract of JsonNodePath). The toString() method should therefore return an empty string."
      },
      {
        "input": [],
        "expected": "java.lang.NullPointerException",
        "description": "If getEvaluationPath() returns null, toString() will attempt to invoke getName(-1) on a null reference and should throw a NullPointerException."
      }
    ]
  },
  {
    "group": "BaseJsonValidator.toString() - edge and special cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "evaluationPathSegments",
            "value": [
              "root",
              "intermediate",
              null
            ]
          }
        ],
        "expected": null,
        "description": "When the last segment of the evaluation path is null, getName(-1) returns null and toString() should propagate that null value."
      },
      {
        "input": [
          {
            "parameter": "evaluationPathSegments",
            "value": []
          },
          {
            "parameter": "getNameThrows",
            "value": "IndexOutOfBoundsException"
          }
        ],
        "expected": "java.lang.IndexOutOfBoundsException",
        "description": "If the JsonNodePath implementation throws an IndexOutOfBoundsException for getName(-1) on an empty path, toString() must not catch it and the same exception should be observed by the caller."
      },
      {
        "input": [
          {
            "parameter": "evaluationPathSegments",
            "value": [
              "root",
              "child",
              "leaf with spaces"
            ]
          }
        ],
        "expected": "leaf with spaces",
        "description": "Verification that toString() returns the exact last segment even when it contains whitespace characters."
      },
      {
        "input": [
          {
            "parameter": "evaluationPathSegments",
            "value": [
              "\u6839",
              "\u5b50\u8282\u70b9",
              "\u53f6\u5b50"
            ]
