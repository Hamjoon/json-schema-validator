[
  {
    "group": "Valid Input - JSON format, validation enabled",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"John\",\"age\":30}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "A well\u2011formed JSON document is supplied. The walk method should deserialize the string, create an ExecutionContext and perform validation, returning a successful ValidationResult."
      }
    ]
  },
  {
    "group": "Valid Input - JSON format, validation disabled",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"city\":\"Paris\",\"population\":2148000}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": false
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "Even when validation is turned off, walk should still return a successful ValidationResult because deserialization succeeds."
      }
    ]
  },
  {
    "group": "Invalid JSON syntax",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"John\", \"age\":}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == false and ValidationResult.getMessages().size() > 0",
        "description": "The JSON string is malformed (trailing comma). deserialize should throw a parsing exception which is captured and reported in the ValidationResult."
      }
    ]
  },
  {
    "group": "Null input string",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": null
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws IllegalArgumentException",
        "description": "walk should reject a null input string early (either in deserialize or in the public overload) and raise an IllegalArgumentException."
      }
    ]
  },
  {
    "group": "Unsupported InputFormat (e.g., YAML when only JSON is supported)",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "name: John\nage: 30"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws UnsupportedOperationException or IOException",
        "description": "When an InputFormat that the current JsonSchema implementation cannot handle is supplied, deserialize should fail and the walk method should propagate the exception."
      }
    ]
  },
  {
    "group": "URL\u2011encoded JSON string",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "%7B%22id%22%3A123%2C%22valid%22%3Atrue%7D"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "walk should internally URL\u2011decode the string (via URLDecoder) before deserialization, resulting in a successful validation."
      }
    ]
  },
  {
    "group": "Malformed JSON with validation disabled",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"John\", \"age\":}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": false
          }
        ],
        "expected": "ValidationResult.isValid() == false and ValidationResult.getMessages().size() > 0",
        "description": "Even when validation is turned off, a syntactically incorrect JSON string cannot be deserialized, so walk should return an invalid ValidationResult with parsing error messages."
      }
    ]
  },
  {
    "group": "Empty string input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": ""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == false and ValidationResult.getMessages().size() > 0",
        "description": "An empty string is not valid JSON; deserialization should fail and walk should report the error in the ValidationResult."
      }
    ]
  },
  {
    "group": "Whitespace\u2011only input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "   \t\n  "
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == false and ValidationResult.getMessages().size() > 0",
        "description": "A string containing only whitespace is not a valid JSON document; walk should treat it as a parsing failure."
      }
    ]
  },
  {
    "group": "Null InputFormat",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"key\":\"value\"}"
          },
          {
            "parameter": "inputFormat",
            "value": null
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws IllegalArgumentException",
        "description": "The method should reject a null InputFormat argument early, throwing an IllegalArgumentException."
      }
    ]
  },
  {
    "group": "Valid YAML input (supported format)",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "name: John\nage: 30"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.YAML"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "When the library supports YAML, a well\u2011formed YAML document should be deserialized and validated successfully."
      }
    ]
  },
  {
    "group": "JSON array input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "[{\"id\":1},{\"id\":2}]"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "A valid JSON array should be accepted and, with validation enabled, produce a successful ValidationResult when the schema does not restrict the root type."
      },
      {
        "input": [
          {
            "parameter": "input",
            "value": "[{\"id\":1},{\"id\":2}]"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": false
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "Even with validation disabled, a correctly formed JSON array should result in a valid ValidationResult."
      }
    ]
  },
  {
    "group": "JSON primitive number input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "12345"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "A JSON document consisting of a single number is syntactically valid; with a permissive schema walk should return a successful ValidationResult."
      }
    ]
  },
  {
    "group": "JSON primitive boolean input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "true"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "A JSON document that is a boolean literal should deserialize correctly and, assuming no type constraints, produce a valid ValidationResult."
      }
    ]
  },
  {
    "group": "JSON null literal input",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "null"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "ValidationResult.isValid() == true and ValidationResult.getMessages().isEmpty()",
        "description": "The JSON literal `null` is a valid JSON document; walk should handle it without errors and return a successful ValidationResult when the schema permits null."
      }
    ]
  },
  {
    "group": "Malformed URL\u2011encoded input string",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "%E0%A4%A"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws IllegalArgumentException",
        "description": "The walk method URL\u2011decodes the input before deserialization. An input with an incomplete or illegal percent\u2011encoding sequence causes URLDecoder to throw IllegalArgumentException, which should propagate out of walk."
      }
    ]
  },
  {
    "group": "Invalid $ref in schema leading to schema resolution failure",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "{\"name\":\"John\"}"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws JsonSchemaException",
        "description": "When the JsonSchema instance contains a $ref that cannot be resolved (e.g., points to a non\u2011existent definition), the walk execution attempts to resolve the reference during validation and throws a JsonSchemaException. The test should construct such a schema and verify the exception is propagated."
      }
    ]
  },
  {
    "group": "Unsupported character set during URL decoding (simulated)",
    "cases": [
      {
        "input": [
          {
            "parameter": "input",
            "value": "%7B%22key%22%3A%22value%22%7D"
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "validate",
            "value": true
          }
        ],
        "expected": "throws UnsupportedEncodingException",
        "description": "If the implementation of walk uses URLDecoder.decode(String, charsetName) with a charset that is not available on the platform, an UnsupportedEncodingException is thrown. This test forces that path (e.g., by mocking the decoder or configuring the library to use a non\u2011standard charset) and verifies the exception is propagated."
      }
    ]
  }
]