[
  {
    "group": "equals(double, double)",
    "cases": [
      {
        "input": [
          {
            "parameter": "n1",
            "value": 5.0
          },
          {
            "parameter": "n2",
            "value": 5.0
          }
        ],
        "expected": true,
        "description": "Identical numbers should be considered equal (difference = 0)."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.0
          },
          {
            "parameter": "n2",
            "value": 1.0000000000005
          }
        ],
        "expected": true,
        "description": "Numbers whose absolute difference (5e-13) is smaller than the tolerance 1e-12 should be equal."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 1e-12
          }
        ],
        "expected": false,
        "description": "Difference exactly equal to the tolerance (1e-12) must evaluate to false because the condition uses '<' not '<='."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 1.5e-12
          }
        ],
        "expected": false,
        "description": "Numbers whose absolute difference (1.5e-12) exceeds the tolerance should not be equal."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1e+20
          },
          {
            "parameter": "n2",
            "value": 1.0000000000005e+20
          }
        ],
        "expected": true,
        "description": "Even with very large magnitudes, equality is based on absolute difference; here the difference is 5e-13, which is within tolerance."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "NaN"
          },
          {
            "parameter": "n2",
            "value": "NaN"
          }
        ],
        "expected": false,
        "description": "Any comparison involving NaN results in false because Math.abs(NaN) is NaN and the '<' comparison yields false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "Infinity"
          },
          {
            "parameter": "n2",
            "value": "Infinity"
          }
        ],
        "expected": false,
        "description": "Positive infinity compared to itself produces NaN after subtraction, so the method returns false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "Infinity"
          },
          {
            "parameter": "n2",
            "value": 1.0
          }
        ],
        "expected": false,
        "description": "Positive infinity vs a finite number yields an infinite difference, which is not less than the tolerance."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "-Infinity"
          },
          {
            "parameter": "n2",
            "value": "-Infinity"
          }
        ],
        "expected": false,
        "description": "Negative infinity compared to itself also results in NaN after subtraction, leading to false."
      }
    ]
  },
  {
    "group": "equals(double, double) - additional cases",
    "cases": [
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": -0.0
          }
        ],
        "expected": true,
        "description": "Positive zero and negative zero have a difference of 0.0, which is less than the tolerance, so they are considered equal."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 5e-324
          }
        ],
        "expected": true,
        "description": "The smallest positive sub\u2011normal double (Double.MIN_VALUE) differs from zero by ~4.9\u00d710\u207b\u00b3\u00b2\u2074, well below the 1e\u201112 tolerance."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 9.99999999999e-13
          }
        ],
        "expected": true,
        "description": "Difference (9.99999999999\u00d710\u207b\u00b9\u00b3) is just under the tolerance (1e\u201112), therefore the numbers are equal."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 0.0
          },
          {
            "parameter": "n2",
            "value": 1.000000000001e-12
          }
        ],
        "expected": false,
        "description": "Difference (1.000000000001\u00d710\u207b\u00b9\u00b2) is just above the tolerance, so the method should return false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 5e-13
          },
          {
            "parameter": "n2",
            "value": -5e-13
          }
        ],
        "expected": false,
        "description": "Numbers with opposite signs have an absolute difference of exactly 1e\u201112 (the tolerance). Because the comparison uses '<' (strictly less), the result is false."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "NaN"
          },
          {
            "parameter": "n2",
            "value": 0.0
          }
        ],
        "expected": false,
        "description": "Any comparison involving NaN yields false; subtraction results in NaN, and the '<' test fails."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": "NaN"
          },
          {
            "parameter": "n2",
            "value": "Infinity"
          }
        ],
        "expected": false,
        "description": "NaN compared with Infinity also returns false for the same reason as above."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.7976931348623157e+308
          },
          {
            "parameter": "n2",
            "value": 1.7976931348623157e+308
          }
        ],
        "expected": true,
        "description": "Two identical maximum\u2011value doubles have zero difference, which is less than the tolerance."
      },
      {
        "input": [
          {
            "parameter": "n1",
            "value": 1.7976931348623157e+308
          },
          {
            "parameter": "n2",
            "value": 1.7976931348623157e+308
          }
        ],
        "expected": true,
        "description": "Two maximum\u2011value doubles where the second operand is mathematically different but too small to affect the double representation (e.g., MAX_VALUE - 1e292). The subtraction underflows to 0.0, so the method reports equality."
      }
    ]
  }
]