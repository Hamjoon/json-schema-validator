[
  {
    "group": "Validate flag true \u2013 normal flow",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"name\":\"John\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"validation passed\"",
        "description": "When `validate` is true and no customizer is supplied, the method should run all validators on the supplied node and return the value produced by the OutputFormat (here a string indicating success)."
      }
    ]
  },
  {
    "group": "Validate flag false \u2013 skip validation",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ArrayNode [1,2,3]"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": false
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"validation skipped\"",
        "description": "When `validate` is false the method must bypass all schema validators and directly invoke the OutputFormat, resulting in a different output that signals validation was skipped."
      }
    ]
  },
  {
    "group": "Non\u2011null executionCustomizer \u2013 should be invoked",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"age\":30}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "mockConsumerThatAddsFlag"
          }
        ],
        "expected": "\"customizer applied\"",
        "description": "A non\u2011null `Consumer<ExecutionContext>` must be called exactly once before validation starts. The mock consumer sets a flag in the ExecutionContext; the OutputFormat can read that flag and return a distinct string."
      }
    ]
  },
  {
    "group": "Null node \u2013 illegal argument",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "null"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "If the supplied `JsonNode` is null the method should throw an `IllegalArgumentException` because there is no instance to walk."
      }
    ]
  },
  {
    "group": "Null outputFormat \u2013 illegal argument",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"id\":\"123\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "null"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "A null `OutputFormat` cannot be used to produce a result; the method should throw a `NullPointerException`."
      }
    ]
  },
  {
    "group": "ExecutionContext customizer \u2013 modifies context before walk",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"type\":\"string\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "mockConsumerThatAddsMetadata"
          }
        ],
        "expected": "\"metadata added\"",
        "description": "When an `ExecutionContextCustomizer` (a Consumer) is supplied, it must be executed before any validation. The mock consumer adds a metadata entry to the context; the OutputFormat reads this entry and returns a string confirming the addition."
      }
    ]
  },
  {
    "group": "Null executionContext \u2013 illegal argument",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "null"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"foo\":\"bar\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "The method must reject a null ExecutionContext because it cannot store traversal state; a NullPointerException should be thrown before any other processing."
      }
    ]
  },
  {
    "group": "ExecutionCustomizer throws \u2013 propagates exception",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"valid\":true}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "mockConsumerThatThrowsRuntimeException"
          }
        ],
        "expected": "RuntimeException",
        "description": "If the supplied Consumer throws a RuntimeException, the walk method must not swallow it; the exception should propagate to the caller."
      }
    ]
  },
  {
    "group": "OutputFormat returns null \u2013 result is null",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"a\":1}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningNull"
          },
          {
            "parameter": "validate",
            "value": false
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "null",
        "description": "When the OutputFormat's `apply` method returns null, walk must forward that null value to the caller (no NPE should be thrown)."
      }
    ]
  },
  {
    "group": "Validate true \u2013 node fails schema validation",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"age\":\"twenty\"}",
            "description": "age should be an integer according to the schema"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatCollectingMessages"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "List containing validation error for property 'age'",
        "description": "With `validate` true the method runs all validators; the mock OutputFormat aggregates the resulting ValidationMessage objects. Because the node violates the schema, the expected result is a collection that includes the specific error about the wrong type of `age`."
      }
    ]
  },
  {
    "group": "Validate true \u2013 nested object passes validation",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"person\":{\"name\":\"Alice\",\"age\":30}}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"nested validation passed\"",
        "description": "The schema contains a nested object definition. When the whole instance conforms, walk must traverse into the child node, invoke its validators, and finally the OutputFormat should receive a successful result (simulated by returning the string)."
      }
    ]
  },
  {
    "group": "Validate true \u2013 schema without validators (type\u2011agnostic)",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"no validators \u2013 treated as valid\"",
        "description": "If the schema does not declare any validators (e.g., an empty schema object), walk should still call the OutputFormat with an empty ValidationResult indicating success."
      }
    ]
  },
  {
    "group": "OutputFormat throws RuntimeException \u2013 propagates",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"key\":\"value\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatThrowingRuntimeException"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "RuntimeException",
        "description": "If the supplied OutputFormat throws a RuntimeException during its apply() call, walk must not catch it; the exception should propagate to the caller."
      }
    ]
  },
  {
    "group": "OutputFormat throws checked exception \u2013 propagates as RuntimeException",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"key\":\"value\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatThrowingIOException"
          },
          {
            "parameter": "validate",
            "value": false
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "RuntimeException",
        "description": "When the OutputFormat's apply method throws a checked exception (e.g., IOException), walk must wrap or re\u2011throw it as an unchecked RuntimeException."
      }
    ]
  },
  {
    "group": "ExecutionCustomizer throws checked exception \u2013 propagates as RuntimeException",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"key\":123}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "mockConsumerThrowingIOException"
          }
        ],
        "expected": "RuntimeException",
        "description": "If the Consumer<ExecutionContext> supplied as executionCustomizer throws a checked exception (e.g., IOException), walk must propagate it as an unchecked RuntimeException."
      }
    ]
  },
  {
    "group": "Node is MissingNode \u2013 illegal argument",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "MissingNode.instance()"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "When the supplied JsonNode is a MissingNode (Jackson's representation of a non\u2011existent property), walk should reject it with an IllegalArgumentException because there is no concrete instance to validate."
      }
    ]
  },
  {
    "group": "Schema $ref with unsupported encoding \u2013 IllegalArgumentException",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContextWithRefSchema"
          },
          {
            "parameter": "node",
            "value": "ObjectNode {\"$ref\":\"http://example.com/schema%ZZ\"}"
          },
          {
            "parameter": "outputFormat",
            "value": "mockOutputFormatReturningString"
          },
          {
            "parameter": "validate",
            "value": true
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "If the schema contains a $ref whose URI cannot be decoded (URLDecoder throws UnsupportedEncodingException), walk should translate this into an IllegalArgumentException."
      }
    ]
  }
]