          },
          {
            "parameter": "parent",
            "value": "null"
          },
          {
            "parameter": "suppressSubSchemaRetrieval",
            "value": "false"
          }
        ],
        "expected": "returns a non\u2011null JsonSchema instance; calling getValidationContext() on it returns null",
        "description": "Verify that the factory method tolerates a null ValidationContext and stores it unchanged."
      }
    ]
  },
