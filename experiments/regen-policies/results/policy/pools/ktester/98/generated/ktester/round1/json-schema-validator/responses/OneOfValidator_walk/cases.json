  {
    "group": "validateWhenShouldValidateTrue",
    "cases": [
      {
        "input": [
          {
            "parameter": "executionContext",
            "value": "mockExecutionContext"
          },
          {
            "parameter": "node",
            "value": "mockNode"
          },
          {
