[
  {
    "group": "Null handling",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "null"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "NullPointerException",
        "description": "When the JSON document (rootNode) is null the method should throw a NullPointerException because validation cannot be performed on a missing node."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"name\":\"John\"})"
          },
          {
            "parameter": "format",
            "value": "null"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "If the OutputFormat argument is null the method must reject the call with an IllegalArgumentException (the format is required to produce a result)."
      }
    ]
  },
  {
    "group": "Successful validation without customizer",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"OK\"",
        "description": "Validate a JSON document that conforms to the schema (e.g., an integer \"age\" property). No customizer is supplied, so the default execution context is used. The SimpleStringFormat should return the string \"OK\" when there are no validation messages."
      }
    ]
  },
  {
    "group": "Validation with errors (no customizer)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":\"thirty\"})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"ERROR: age: integer expected\"",
        "description": "Validate a JSON document that violates the schema (string instead of integer for \"age\"). The format should receive the validation messages and return a string that contains the error description."
      }
    ]
  },
  {
    "group": "Validation with ExecutionContextCustomizer",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.setConfig(new SchemaValidatorsConfig().setFailFast(true))"
          }
        ],
        "expected": "\"OK\"",
        "description": "Provide a customizer that switches the execution context to fail\u2011fast mode. Because the document is valid, validation succeeds and the format returns \"OK\"."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":\"thirty\"})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.setConfig(new SchemaValidatorsConfig().setFailFast(true))"
          }
        ],
        "expected": "\"ERROR: age: integer expected\"",
        "description": "Same fail\u2011fast customizer but the document contains a validation error. The validator should stop after the first error and the format should return the single error message."
      }
    ]
  },
  {
    "group": "Custom OutputFormat behavior",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[ ]",
        "description": "A custom OutputFormat that collects ValidationMessage objects into a List. For a valid document the list should be empty."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":\"thirty\"})"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[\"age: integer expected\"]",
        "description": "Using the same CollectingListFormat, the invalid document should produce a list containing a single validation message."
      }
    ]
  },
  {
    "group": "Missing required property",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"ERROR: age: is required\"",
        "description": "The schema defines the property \"age\" as required. An empty object should trigger a validation error indicating the missing required property."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({})"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[\"age: is required\"]",
        "description": "Using a List\u2011collecting OutputFormat, the same missing\u2011property case should produce a list containing a single ValidationMessage about the required field."
      }
    ]
  },
  {
    "group": "Disallowed additional property",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30,\"extra\":\"value\"})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"ERROR: #: extraneous property \\\"extra\\\" is not allowed\"",
        "description": "The schema has \"additionalProperties\": false. Supplying an unexpected property should cause a validation error that mentions the extraneous property."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30,\"extra\":\"value\"})"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[\"#: extraneous property \\\"extra\\\" is not allowed\"]",
        "description": "CollectingListFormat should return a list with the same additional\u2011property error message."
      }
    ]
  },
  {
    "group": "Array element type validation",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "arrayNode([1,2,\"three\"])"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"ERROR: [2]: integer expected\"",
        "description": "The schema expects an array of integers. The third element is a string, so validation must report an error at index 2."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "arrayNode([1,2,\"three\"])"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[\"[2]: integer expected\"]",
        "description": "CollectingListFormat should return a list containing the array\u2011element type error."
      }
    ]
  },
  {
    "group": "Root node type mismatch (primitive vs object)",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "textNode(\"just a string\")"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "\"ERROR: #: object expected\"",
        "description": "The schema describes an object, but the supplied root node is a JSON string. Validation must fail with a type\u2011mismatch message."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "textNode(\"just a string\")"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "[\"#: object expected\"]",
        "description": "List\u2011collecting format should contain the same type\u2011mismatch ValidationMessage."
      }
    ]
  },
  {
    "group": "ExecutionContextCustomizer that disables fail\u2011fast",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":\"thirty\",\"name\":123})"
          },
          {
            "parameter": "format",
            "value": "new CollectingListFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.setConfig(new SchemaValidatorsConfig().setFailFast(false))"
          }
        ],
        "expected": "[\"age: integer expected\",\"name: string expected\"]",
        "description": "With fail\u2011fast disabled the validator should collect **all** errors (type error on \"age\" and type error on \"name\"). The customizer explicitly sets failFast to false."
      },
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":\"thirty\",\"name\":123})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> ctx.setConfig(new SchemaValidatorsConfig().setFailFast(false))"
          }
        ],
        "expected": "\"ERROR: age: integer expected; name: string expected\"",
        "description": "SimpleStringFormat should concatenate all collected messages when fail\u2011fast is turned off."
      }
    ]
  },
  {
    "group": "$ref handling - UnsupportedEncodingException",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"ref\":\"value\"})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "UnsupportedEncodingException",
        "description": "The schema contains a $ref with an illegal URL encoding (e.g., \"#/components/schemas/Invalid%ZZ\"). During validation the resolver calls URLDecoder.decode which throws UnsupportedEncodingException. The validate method must propagate this exception."
      }
    ]
  },
  {
    "group": "$ref handling - IOException on external schema",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"ref\":\"value\"})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IOException",
        "description": "The schema contains an external $ref that points to a non\u2011existent file or an unreachable URL (e.g., \"file:/nonexistent/schema.json\"). When the validator tries to read the referenced schema it throws an IOException, which should be propagated by the validate method."
      }
    ]
  },
  {
    "group": "ExecutionContextCustomizer exception propagation",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "ctx -> { throw new IllegalStateException(\"customizer failure\"); }"
          }
        ],
        "expected": "IllegalStateException",
        "description": "A custom ExecutionContextCustomizer throws an unchecked exception while configuring the ExecutionContext. The validate method must not swallow the exception; it should propagate it to the caller."
      }
    ]
  },
  {
    "group": "OutputFormat exception propagation",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new FaultyFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "RuntimeException",
        "description": "The supplied OutputFormat implementation throws a RuntimeException (e.g., in its `apply` method). The validate method should let this exception bubble up rather than converting it to a validation message."
      }
    ]
  },
  {
    "group": "Invalid schema definition - IllegalArgumentException",
    "cases": [
      {
        "input": [
          {
            "parameter": "rootNode",
            "value": "objectNode({\"age\":30})"
          },
          {
            "parameter": "format",
            "value": "new SimpleStringFormat()"
          },
          {
            "parameter": "executionCustomizer",
            "value": "null"
          }
        ],
        "expected": "IllegalArgumentException",
        "description": "The JsonSchema instance is created from a malformed schema JSON (e.g., a property \"type\" with an unsupported value \"unknown\"). During validator initialization an IllegalArgumentException is thrown, which must be propagated by the validate method."
      }
    ]
  }
]