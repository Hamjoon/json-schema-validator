          },
          {
            "parameter": "input",
            "value": "\"{\\\"key\\\":\\\"value\\\"}\""
          },
          {
            "parameter": "inputFormat",
            "value": "InputFormat.JSON"
          },
          {
            "parameter": "outputFormat",
            "value": "new OutputFormat<Object>() { public Object apply(Set<ValidationMessage> msgs) { throw new RuntimeException(\"output failure\"); } }"
