          },
          {
            "parameter": "schemaNode",
            "value": "JsonMapperFactory.getInstance().readTree(\"{\\\"type\\\":\\\"string\\\"}\")"
          },
          {
            "parameter": "parent",
            "value": "JsonSchema.from(new ValidationContext(), new SchemaLocation(\"classpath:/parent-schema.json\"), new JsonNodePath(\"$\"), JsonMapperFactory.getInstance().readTree(\"{\\\"type\\\":\\\"object\\\"}\"), null, false)"
          },
          {
            "parameter": "suppressSubSchemaRetrieval",
            "value": "true"
          }
        ],
        "expected": "A non\u2011null JsonSchema instance whose findAncestor() returns the supplied parent schema and whose internal suppressSubSchemaRetrieval flag is true.",
        "description": "Ensures that when a parent JsonSchema is supplied, the created schema correctly records the ancestor relationship and respects the suppress flag."
      }
    ]
  },
