[
  {
    "group": "Construction with all non\u2011null arguments (suppressSubSchemaRetrieval = false)",
    "cases": [
      {
        "input": [
          {
            "parameter": "validationContext",
            "value": "new ValidationContext()"
          },
          {
            "parameter": "schemaLocation",
            "value": "new SchemaLocation(\"classpath:/schema.json\")"
          },
          {
            "parameter": "evaluationPath",
            "value": "new JsonNodePath(\"$\")"
          },
          {
            "parameter": "schemaNode",
            "value": "JsonMapperFactory.getInstance().readTree(\"{\\\"type\\\":\\\"object\\\"}\")"
          },
          {
            "parameter": "parent",
            "value": "null"
          },
          {
            "parameter": "suppressSubSchemaRetrieval",
            "value": "false"
          }
        ],
        "expected": "A non\u2011null JsonSchema instance whose getValidationContext() returns the supplied ValidationContext, whose getId() matches the supplied SchemaLocation, whose findAncestor() returns null (no parent), and whose internal flag for suppressSubSchemaRetrieval is false.",
        "description": "Verifies that the static factory creates a proper JsonSchema object when all required arguments are provided and the suppress flag is false."
      }
    ]
  },
  {
    "group": "Construction with parent schema (suppressSubSchemaRetrieval = true)",
    "cases": [
      {
        "input": [
          {
            "parameter": "validationContext",
            "value": "new ValidationContext()"
          },
          {
            "parameter": "schemaLocation",
            "value": "new SchemaLocation(\"classpath:/child-schema.json\")"
          },
          {
            "parameter": "evaluationPath",
